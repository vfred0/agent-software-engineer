@startuml appointment
!include ./settings.puml

' ==== Layout claro ====
left to right direction
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #FAFAFA
  BorderColor #7a8a9a
}
hide stereotype

actor Sistema

rectangle "Citas" as C {
  useCase(Sistema, BuscarCita)
  useCase(Sistema, ReagendarCita)
  useCase(Sistema, ActualizarCita)
  useCase(Sistema, CambiarEstadoCita)
  useCase(Sistema, EliminarCita)
}

rectangle "Gestión Interna" as G {
  together {
    useCase(Sistema, GestionComun)
    useCase(Sistema, AbrirCita)
    useCase(Sistema, RegistrarHistorialCita)
  }
  includesRelation(GestionComun, AbrirCita)
  includesRelation(GestionComun, RegistrarHistorialCita)

  together {
    useCase(Sistema, ValidarAgenda)
    useCase(Sistema, ValidarDisponibilidad)
    useCase(Sistema, VerificarConflictosHorario)
    useCase(Sistema, ActualizarBloquesAgenda)
  }
  includesRelation(ValidarAgenda, ValidarDisponibilidad)
  includesRelation(ValidarAgenda, VerificarConflictosHorario)
  includesRelation(ValidarAgenda, ActualizarBloquesAgenda)

includesRelation(ReagendarCita, GestionComun)
includesRelation(ReagendarCita, ValidarAgenda)

includesRelation(ActualizarCita, GestionComun)
includesRelation(ActualizarCita, ValidarAgenda)

includesRelation(CambiarEstadoCita, GestionComun)
includesRelation(CambiarEstadoCita, NotificarCambios)

includesRelation(EliminarCita, GestionComun)

@enduml
